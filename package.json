{
  "name": "shore-and-grace",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "start": "turbo start",
    "lint": "turbo lint",
    "test": "turbo test",
    "backend:seed-demo": "pnpm --dir apps/backend exec medusa exec ./src/scripts/seed-demo-products.ts",
    "backend:dev": "turbo dev --filter=@shore-and-grace/backend",
    "storefront:dev": "turbo dev --filter=@shore-and-grace/storefront",
    "holding:dev": "turbo dev --filter=@shore-and-grace/holding",
    "infra:up": "docker compose -f infrastructure/compose.yaml up -d",
    "infra:down": "docker compose -f infrastructure/compose.yaml down",
    "infra:logs": "docker compose -f infrastructure/compose.yaml logs -f"
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.22.0",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "turbo": "^2.0.14"
  }
}
